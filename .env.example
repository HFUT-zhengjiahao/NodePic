# NodePic 环境变量示例
#
# 复制成 .env.local 再按需填写（.env.local 已被 .gitignore 忽略，不会进仓库）：
#
#     cp .env.example .env.local
#
# 全部都是可选的。也可以什么都不填，启动后在应用里「设置 → API 接口」填写密钥 ——
# 设置页里的值优先于这里的环境变量，且不需要重启。

# ── 图片接口 ────────────────────────────────────────────────────────────────
# 密钥：OpenAI 官方密钥，或兼容 OpenAI 的中转服务（如 PackyAPI）密钥。
OPENAI_API_KEY=

# 接口地址：留空 / 删掉这一行 = 使用官方 https://api.openai.com/v1
# 用中转时填完整前缀，例如：
# OPENAI_API_BASE_URL=https://cf.api.fan/v1
OPENAI_API_BASE_URL=

# ── 访问控制（可选）─────────────────────────────────────────────────────────
# 设置后，所有写操作都需要密码（界面会弹密码框）。暴露到局域网 / 公网时请务必设置。
# APP_PASSWORD=

# ── 存储与限额（可选）───────────────────────────────────────────────────────
# 图片存哪里：fs = 服务器磁盘的图片目录（默认）；indexeddb = 浏览器里（Vercel 等 serverless）。
# NEXT_PUBLIC_IMAGE_STORAGE_MODE=fs

# 一个编辑节点最多挂几张源图，上限 16。
# NEXT_PUBLIC_MAX_EDIT_SOURCES=16

# 单张上传 / 从上游下载生成结果的大小上限（MB）。
# IMAGE_UPLOAD_MAX_MB=25
# IMAGE_DOWNLOAD_MAX_MB=25

# 单次生成请求超时（毫秒）。
# IMAGE_PROVIDER_TIMEOUT_MS=180000

# 清理任务只删除超过这个时长的临时文件（分钟）。
# IMAGE_CLEANUP_MIN_AGE_MINUTES=10

# 服务端口（默认 3000）。
# PORT=3000
