# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template: it documents the optional variables and holds no secrets.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated pictures, the image registry and the trash inside it.
# A fresh clone starts with an empty canvas: the app creates this folder on first use.
generated-images/

# local run state (pid/log of the dev server started from the shortcut)
.run/

# per-machine settings. The API key typed into the settings panel is stored here, so this file
# must never be committed — it is why the panel can ship without credentials.
.playground-settings.json

# exports of the local workspace (canvas nodes, history, preferences) and one-off canvas snapshots.
# These are personal data, not project files.
workspace-backup/
canvas-backups/
NOTES.local.md
